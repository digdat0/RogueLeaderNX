+// The konst selectors live in TEV_KSEL registers shared by pairs of stages and keep what the
+// last draw set, so a stage that reads no KONST input still carries one. In the pipeline key
+// that made up to three pipelines of one shader (Rogue Leader: 6,132 cached, 2,123 distinct),
+// and a draw whose variant was not built yet was skipped until it was: objects popped in.
+void normalize_pipeline_config(PipelineConfig& config) noexcept {
+  auto& sc = config.shaderConfig;
+  for (u32 i = 0; i < sc.tevStageCount && i < MaxTevStages; ++i) {
+    auto& stage = sc.tevStages[i];
+    const auto& c = stage.colorPass;
+    const auto& a = stage.alphaPass;
+    if (c.a != GX_CC_KONST && c.b != GX_CC_KONST && c.c != GX_CC_KONST && c.d != GX_CC_KONST) {
+      stage.kcSel = TevStage{}.kcSel;
+    }
+    if (a.a != GX_CA_KONST && a.b != GX_CA_KONST && a.c != GX_CA_KONST && a.d != GX_CA_KONST) {
+      stage.kaSel = TevStage{}.kaSel;
+    }
+  }
+}
