+// Model-view position of one vertex of raw vertex data, as the vertex shader computes it.
+bool vertex_mv_pos(GXVtxFmt fmt, const u8* vtx, Vec4<float>& out) noexcept {
+  const auto& state = g_gxState;
+  const auto& vtxFmt = state.vtxFmts[fmt];
+  u32 mtx = state.currentPnMtx;
+  u32 offset = 0;
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_POS; ++i) {
+    const auto attr = static_cast<GXAttr>(i);
+    const auto type = state.vtxDesc[i];
+    const auto& attrFmt = vtxFmt.attrs[i];
+    if (type == GX_NONE) {
+      continue;
+    }
+    if (attr == GX_VA_POS) {
+      const u8* src = vtx + offset;
+      bool le = false;
+      const u8 cnt = comp_cnt_count(attr, attrFmt.cnt);
+      const u8 size = comp_type_size(attr, attrFmt.type);
+      if (type == GX_INDEX8 || type == GX_INDEX16) {
+        const u32 idx = type == GX_INDEX8 ? src[0] : (u32(src[0]) << 8 | src[1]);
+        const auto& array = state.arrays[GX_VA_POS];
+        const u32 at = idx * array.stride;
+        if (array.data == nullptr || at > array.size || u32(size) * cnt > array.size - at) {
+          return false;
+        }
+        src = static_cast<const u8*>(array.data) + at;
+        le = array.le;
+      }
+      const Vec4<float> pos{read_component(src, attrFmt.type, attrFmt.frac, le),
+                            read_component(src + size, attrFmt.type, attrFmt.frac, le),
+                            cnt == 3 ? read_component(src + 2 * size, attrFmt.type, attrFmt.frac, le) : 0.f, 1.f};
+      Mat3x4<float> m{{1.f, 0.f, 0.f, 0.f}, {0.f, 1.f, 0.f, 0.f}, {0.f, 0.f, 1.f, 0.f}}; // GX_IDENTITY
+      if (mtx < MaxPnMtx) {
+        m = state.pnMtx[mtx].pos;
+      } else if (mtx < MaxPnMtx + MaxTexMtx) {
+        m = state.texMtxs[mtx - MaxPnMtx];
+      }
+      const auto dot4 = [](const Vec4<float>& a, const Vec4<float>& b) {
+        return a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3];
+      };
+      out = {dot4(pos, m.m0), dot4(pos, m.m1), dot4(pos, m.m2), 1.f};
+      return true;
+    }
+    if (attr == GX_VA_PNMTXIDX) {
+      mtx = vtx[offset] / 3;
+    }
+    if (type == GX_DIRECT) {
+      offset += comp_type_size(attr, attrFmt.type) * comp_cnt_count(attr, attrFmt.cnt);
+    } else {
+      offset += type == GX_INDEX8 ? 1 : 2;
+    }
+  }
+  return false;
+}
+
+void update_zfreeze_plane(GXVtxFmt fmt, const u8* lastVerts, u32 vtxSize) noexcept {
+  auto& state = g_gxState;
+  // the projection and viewport depth range as fill_uniform and the vertex shader apply them
+  auto proj = state.proj;
+  if constexpr (UseReversedZ) {
+    proj.m2 = proj.m2 * Vec4{-1.f, -1.f, -1.f, -1.f};
+  } else {
+    proj.m2 = proj.m2 + proj.m3;
+  }
+  const auto& lvp = state.logicalViewport;
+  const double depthBase = UseReversedZ ? 1.0 - lvp.zfar : lvp.znear;
+  const double depthRange = lvp.zfar - lvp.znear;
+  const auto& vp = state.renderViewport;
+  double sx[3], sy[3], sz[3];
+  for (u32 i = 0; i < 3; ++i) {
+    Vec4<float> mv;
+    if (!vertex_mv_pos(fmt, lastVerts + i * vtxSize, mv)) {
+      return;
+    }
+    double clip[4];
+    for (int r = 0; r < 4; ++r) {
+      const auto& row = proj[r];
+      clip[r] = double(row[0]) * mv[0] + double(row[1]) * mv[1] + double(row[2]) * mv[2] + double(row[3]);
+    }
+    if (clip[2] >= 0.0 && clip[2] <= clip[3]) {
+      clip[2] = std::clamp(clip[3] * depthBase + clip[2] * depthRange, 0.0, clip[3]);
+    }
+    if (clip[3] == 0.0) {
+      return;
+    }
+    const double invW = 1.0 / clip[3];
+    sx[i] = vp.left + (clip[0] * invW + 1.0) * 0.5 * vp.width;
+    sy[i] = vp.top + (1.0 - clip[1] * invW) * 0.5 * vp.height;
+    sz[i] = clip[2] * invW;
+  }
+  // depth = a * x + b * y + c through the three screen-space vertices
+  const double dx1 = sx[1] - sx[0], dy1 = sy[1] - sy[0], dz1 = sz[1] - sz[0];
+  const double dx2 = sx[2] - sx[0], dy2 = sy[2] - sy[0], dz2 = sz[2] - sz[0];
+  const double det = dx1 * dy2 - dx2 * dy1;
+  if (det == 0.0 || !std::isfinite(det)) {
+    return; // degenerate: keep the previous plane
+  }
+  const double a = (dz1 * dy2 - dz2 * dy1) / det;
+  const double b = (dx1 * dz2 - dx2 * dz1) / det;
+  const double c = sz[0] - a * sx[0] - b * sy[0];
+  state.zFreezePlane = {static_cast<float>(a), static_cast<float>(b), static_cast<float>(c), 0.f};
+  ++state.zFreezePlaneGen;
+}
