   g_gxState.hudAnchoring = anchor;
 }
 
+void AuroraSetWidenedAspects(const float* aspects, u32 count) {
+  aurora::gx::fifo::drain();
+  count = std::min<u32>(count, static_cast<u32>(g_gxState.widenedAspects.size()));
+  for (u32 i = 0; i < count; ++i) {
+    g_gxState.widenedAspects[i] = aspects[i];
+  }
+  g_gxState.widenedAspectCount = count;
+}
