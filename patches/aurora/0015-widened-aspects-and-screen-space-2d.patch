+/**
+ * Widescreen: orthographic draws that follow take their coordinates as screen positions of the
+ * target as it is (e.g. corners a game projected from 3D with a camera already widened for the
+ * display): no 4:3 layout, no HUD anchoring. Followed by:
+ *   u8 1 = on, 0 = off (the default)
+ */
+#define GX_AURORA_SET_SCREEN_SPACE_2D 0x003D
+
 /**
