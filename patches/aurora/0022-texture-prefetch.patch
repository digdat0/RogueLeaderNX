+void prefetch_replacements(uint64_t budgetBytes) {
+  std::vector<EntryLoadSnapshot> snapshots;
+  {
+    std::lock_guard lock{s_registryMutex};
+    for (const auto& [key, entries] : s_entriesByKey) {
+      const auto* entry = find_selected_entry_locked(key);
+      if (entry == nullptr || entry->kind == EntryKind::Raw || s_failedIds.contains(entry->id)) {
+        continue;
+      }
+      snapshots.push_back(snapshot_entry(key, *entry));
+    }
+  }
+  s_prefetchBudget.store(budgetBytes, std::memory_order_relaxed);
+  s_prefetchFull.store(false, std::memory_order_relaxed);
+  s_prefetchTotal.fetch_add(snapshots.size(), std::memory_order_relaxed);
+  start_worker_pool();
+  {
+    std::lock_guard lock{s_jobMutex};
+    for (auto& snapshot : snapshots) {
+      s_lowPriorityJobs.push_back({.tier = Tier::Prefetch, .entry = std::move(snapshot)});
+    }
+  }
+  s_jobCv.notify_all();
+}
+
+void clear_prefetched_replacements() {
+  {
+    std::lock_guard lock{s_prefetchMutex};
+    s_prefetched.clear();
+  }
+  s_prefetchBytes.store(0, std::memory_order_relaxed);
+  s_prefetchFull.store(false, std::memory_order_relaxed);
+}
+
+PrefetchStatus prefetch_status() {
