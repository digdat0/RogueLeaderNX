+      .done = s_prefetchDone.load(std::memory_order_relaxed),
+      .bytes = s_prefetchBytes.load(std::memory_order_relaxed),
+      .budgetFull = s_prefetchFull.load(std::memory_order_relaxed),
+  };
+}
